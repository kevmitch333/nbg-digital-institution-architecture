# Versioned with the static export so future deployments retain protection.
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Do not serve hidden repository/configuration files; retain ACME discovery.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always setifempty X-Content-Type-Options "nosniff"
  Header always setifempty Referrer-Policy "strict-origin-when-cross-origin"
  Header always setifempty Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Initial one-day policy, deliberately without subdomains or preload.
  Header always setifempty Strict-Transport-Security "max-age=86400"
  # Baseline restrictions do not block Next.js or the existing SendFox embed.
  Header always setifempty Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
  # Candidate resource policy: console-only observation, not enforced.
  Header always setifempty Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://cdn.sendfox.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://sendfox.com https://cdn.sendfox.com; connect-src 'self' https://sendfox.com; frame-src https://sendfox.com https://www.google.com/recaptcha/"
</IfModule>
